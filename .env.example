# Copy this file to .env and adjust it for the machine that runs the app.
# .env is git-ignored - never commit real keys or machine-specific paths.
#
# Values that are already set in the real environment win over this file.

# Signs session cookies. Change it on any shared or demo machine.
SECRET_KEY=change-me-before-the-clinic-uses-it

# Where the SQLite database lives. A relative SQLite path is resolved inside
# the "instance" folder, so "sqlite:///dunbar.sqlite3" means
# instance/dunbar.sqlite3. Leave it unset to use the default.
DATABASE_URL=sqlite:///dunbar.sqlite3

# 1 turns the interactive debugger on (development only), 0 keeps it off.
FLASK_DEBUG=0
